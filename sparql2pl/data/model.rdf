  <menu rdf:about="http://www.semanticweb.org/food#chicken_menu">
    <price rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >200</price>
    <dish>
      <food rdf:about="http://www.semanticweb.org/food#soup">
        <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >35</time>
        <season>
          <condiment rdf:about="http://www.semanticweb.org/food#pepper">
            <rdf:type>
              <rdfs:Resource rdf:about="http://www.w3.org/2002/07/owl#NamedIndividual">
                <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
              </rdfs:Resource>
            </rdf:type>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </condiment>
        </season>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#pumpkin">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <season>
          <condiment rdf:about="http://www.semanticweb.org/food#salt">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </condiment>
        </season>
        <cooked>
          <procedure rdf:about="http://www.semanticweb.org/food#stew">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </procedure>
        </cooked>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#water">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#onion">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#garlic">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
      </food>
    </dish>
    <dish>
      <food rdf:about="http://www.semanticweb.org/food#roasted_chicken">
        <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >60</time>
        <season rdf:resource="http://www.semanticweb.org/food#salt"/>
        <made_from rdf:resource="http://www.semanticweb.org/food#garlic"/>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#chicken">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#butter">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <cooked>
          <procedure rdf:about="http://www.semanticweb.org/food#roast">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </procedure>
        </cooked>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
      </food>
    </dish>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </menu>
  <menu rdf:about="http://www.semanticweb.org/food#burger_menu">
    <price rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >100</price>
    <dish>
      <food rdf:about="http://www.semanticweb.org/food#salad">
        <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >15</time>
        <season rdf:resource="http://www.semanticweb.org/food#salt"/>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#tomato">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from rdf:resource="http://www.semanticweb.org/food#onion"/>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#oil">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#lettuce">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <cooked>
          <procedure rdf:about="http://www.semanticweb.org/food#raw">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </procedure>
        </cooked>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
      </food>
    </dish>
    <dish>
      <food rdf:about="http://www.semanticweb.org/food#cake">
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#flour">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#egg">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#milk">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <made_from rdf:resource="http://www.semanticweb.org/food#butter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <made_from>
          <ingredient rdf:about="http://www.semanticweb.org/food#fruit">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#food"/>
          </ingredient>
        </made_from>
        <cooked>
          <procedure rdf:about="http://www.semanticweb.org/food#bake">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </procedure>
        </cooked>
        <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >120</time>
        <season>
          <condiment rdf:about="http://www.semanticweb.org/food#sugar">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
          </condiment>
        </season>
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
      </food>
    </dish>
    <dish>
      <owl:NamedIndividual rdf:about="http://www.semanticweb.org/food#burger">
        <made_from>
          <food rdf:about="http://www.semanticweb.org/food#cheese">
            <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >60</time>
            <season rdf:resource="http://www.semanticweb.org/food#salt"/>
            <made_from rdf:resource="http://www.semanticweb.org/food#milk"/>
            <cooked rdf:resource="http://www.semanticweb.org/food#raw"/>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#ingredient"/>
          </food>
        </made_from>
        <season rdf:resource="http://www.semanticweb.org/food#salt"/>
        <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >20</time>
        <made_from rdf:resource="http://www.semanticweb.org/food#tomato"/>
        <made_from>
          <food rdf:about="http://www.semanticweb.org/food#bread">
            <time rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >120</time>
            <season rdf:resource="http://www.semanticweb.org/food#salt"/>
            <made_from rdf:resource="http://www.semanticweb.org/food#water"/>
            <made_from rdf:resource="http://www.semanticweb.org/food#flour"/>
            <cooked rdf:resource="http://www.semanticweb.org/food#bake"/>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
            <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
            <rdf:type rdf:resource="http://www.semanticweb.org/food#ingredient"/>
          </food>
